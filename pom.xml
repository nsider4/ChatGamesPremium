<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.nsider</groupId>
    <artifactId>ChatGames-Premium</artifactId>
    <version>2.0.3</version>
    <packaging>jar</packaging>

    <name>ChatGames-Premium</name>

    <properties>
        <!-- Java 8 bytecode keeps 1.8.8 servers working; it also runs on Java 25 (MC 26.x / Folia) -->
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <shade.base>org.nsider.chatgames.lib</shade.base>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Line numbers stay for stack traces; local variable tables only add weight -->
                    <debuglevel>source,lines</debuglevel>
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <!-- Drops library classes nothing reaches (XSeries alone is ~770 KB in full) -->
                            <minimizeJar>true</minimizeJar>
                            <!-- Every shaded library is relocated so it can't clash with another plugin's copy -->
                            <relocations>
                                <relocation>
                                    <pattern>com.zaxxer.hikari</pattern>
                                    <shadedPattern>${shade.base}.hikari</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>${shade.base}.slf4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.nsider.inventorymanager</pattern>
                                    <shadedPattern>${shade.base}.inventorymanager</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.cryptomorin.xseries</pattern>
                                    <shadedPattern>${shade.base}.xseries</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.tcoded.folialib</pattern>
                                    <shadedPattern>${shade.base}.folialib</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <!-- FoliaLib picks its scheduler implementation by name, which minimizeJar can't see -->
                                <filter>
                                    <artifact>com.tcoded:FoliaLib</artifact>
                                    <includes>
                                        <include>**</include>
                                    </includes>
                                </filter>
                                <!--
                                  minimizeJar keeps whatever a kept class names, even in code that never runs.
                                  XRegistry names every registry only in ensureLoadedRegistries(), reached through
                                  registryOf()/rawRegistryOf(), which neither ChatGames, InventoryManager nor XSeries
                                  calls; XReflection names the ASM and proxy generators only in proxify(), also
                                  never called. The JVM loads a class on first use, so these are never needed.
                                  Recheck after an XSeries upgrade (scripts/xseries-check.py).
                                -->
                                <filter>
                                    <artifact>com.github.cryptomorin:XSeries</artifact>
                                    <excludes>
                                        <exclude>com/cryptomorin/xseries/XAttribute*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/XBiome*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/XItemFlag*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/XPotion*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/particles/**</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/asm/**</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/StaticReflectiveHandle*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/ReflectiveProxy.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/ReflectiveProxy$*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/ClassOverloadedMethods*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/OverloadedMethod*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/processors/**</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/Constructor.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/Field.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/Final.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/MappedMinecraftName*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/Private.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/Protected.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/Proxify.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/ReflectMinecraftPackage.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/ReflectName*.class</exclude>
                                        <exclude>com/cryptomorin/xseries/reflection/proxy/annotations/Static.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/maven/**</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>clip-repo</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
        <repository>
            <id>tcoded-releases</id>
            <url>https://repo.tcoded.com/releases</url>
        </repository>
        <repository>
            <id>scarsz</id>
            <url>https://nexus.scarsz.me/content/groups/public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.3</version>
            <scope>provided</scope>
        </dependency>
        <!-- Optional: posts through a server's DiscordSRV bot; only loaded when DiscordSRV is installed -->
        <dependency>
            <groupId>com.discordsrv</groupId>
            <artifactId>discordsrv</artifactId>
            <version>1.30.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.nsider4</groupId>
            <artifactId>InventoryManager</artifactId>
            <version>2.0.2</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>4.0.3</version>
            <scope>compile</scope>
        </dependency>
        <!-- HikariCP logs through SLF4J; without a binding it prints a warning to stderr on every start,
             which Paper reports as an error. The no-op binding keeps the console quiet. The API is pinned
             to 1.7 because HikariCP asks for a 2.0 alpha, which finds bindings by ServiceLoader (invisible to
             minimizeJar) and ignores 1.7 bindings. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.36</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>1.7.36</version>
            <scope>compile</scope>
        </dependency>
        <!-- Cross-version materials, sounds and entity types (1.8.8 to 26.x) -->
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
            <version>14.0.0</version>
            <scope>compile</scope>
        </dependency>
        <!-- Picks Folia region schedulers or the Bukkit scheduler at runtime -->
        <dependency>
            <groupId>com.tcoded</groupId>
            <artifactId>FoliaLib</artifactId>
            <version>0.5.1</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Servers ship their own SQLite driver; this copy is only for database tests -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.45.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
